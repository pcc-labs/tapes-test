# Copy to .env in the directory you run tapes-skills-demo from. A key
# already exported in the shell wins over this file.
OPENAI_API_KEY=sk-...

# Optional. The model that writes skills: an OpenAI model (default
# gpt-4o-mini), or with --ollama an Ollama one (default llama3.2).
# TAPES_SKILL_MODEL=
